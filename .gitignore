# PDF files
*.pdf

# Image files (large)
*.PNG
*.png
*.jpg
*.JPG

# CAS-2026 final curated images MUST be committed (referenced by GitHub Pages)
!images-cas-2026/**/*.png
!images-cas-2026/**/*.PNG

# CAS-2026 reference PDFs MUST be committed (guideline / review collection for content review)
!docs/cas-2026/references/**/*.pdf
!docs/cas-2026/references/**/*.xml

# ProGlide teaching module images MUST be committed (referenced by ProGlide_Checklist.html)
!ProGlide_*.png
!ProGlide_*.PNG

# Heart Failure Handbook images MUST be committed (referenced by GitHub Pages)
!heart-failure-handbook/images/*.jpg

# PCI vs CABG Shared Decision-Making aid: web images (jpg + Servier png) MUST be committed
# (the Tufte PDF is intentionally NOT uploaded — too large; it stays local only)
!pci-cabg-decision-aid/images/*.jpg
!pci-cabg-decision-aid/images/*.png

# PCI vs CABG LaTeX/PDF source: commit the source + figure PNGs, but ignore the heavy
# bundled fonts (~40 MB, reproducible) and the compiled PDF / aux files.
pci-cabg-pdf-source/fonts/
pci-cabg-pdf-source/*.aux
pci-cabg-pdf-source/*.log
pci-cabg-pdf-source/*.out
pci-cabg-pdf-source/*.toc
pci-cabg-pdf-source/*.fls
pci-cabg-pdf-source/*.fdb_latexmk
pci-cabg-pdf-source/*.xdv
!pci-cabg-pdf-source/images/*.png

# Office documents
*.docx
*.doc

# Claude Code local settings
.claude/

# Archive (not deployed)
Archive Folder/

# Logs
firebase-debug.log

# Misc
nul

# CAS-2026 extracted PNGs (regenerable from source slides)
docs/cas-2026/*/
!docs/cas-2026/*-slides-overview.html
!docs/cas-2026/references/
!docs/cas-2026/references/**

# Dev tool caches
.playwright-mcp/
node_modules/
__pycache__/
*.pyc

# 內部規劃文件（spec/plan），不進公開教學 repo
docs/superpowers/
