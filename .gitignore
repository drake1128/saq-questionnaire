# PDF files
*.pdf

# Image files (large)
*.PNG
*.png
*.jpg
*.JPG

# CAS-2026 final curated images MUST be committed (referenced by GitHub Pages)
!images-cas-2026/**/*.png
!images-cas-2026/**/*.PNG

# CAS-2026 reference PDFs MUST be committed (guideline / review collection for content review)
!docs/cas-2026/references/**/*.pdf
!docs/cas-2026/references/**/*.xml

# ProGlide teaching module images MUST be committed (referenced by ProGlide_Checklist.html)
!ProGlide_*.png
!ProGlide_*.PNG

# Heart Failure Handbook images MUST be committed (referenced by GitHub Pages)
!heart-failure-handbook/images/*.jpg

# Office documents
*.docx
*.doc

# Claude Code local settings
.claude/

# Archive (not deployed)
Archive Folder/

# Logs
firebase-debug.log

# Misc
nul

# CAS-2026 extracted PNGs (regenerable from source slides)
docs/cas-2026/*/
!docs/cas-2026/*-slides-overview.html
!docs/cas-2026/references/
!docs/cas-2026/references/**

# Dev tool caches
.playwright-mcp/
node_modules/
__pycache__/
*.pyc

